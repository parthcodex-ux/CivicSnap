# ==============================================================================
# CivicSnap Environment Configuration Template
# Copy this file to .env before starting the server or client
# ==============================================================================

# Server Environment
PORT=4000
NODE_ENV=development
CLIENT_ORIGIN=http://localhost:5173

# Google Gemini / Gemma 4 API Configuration
# Get key from: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_or_gemma_api_key_here
GEMMA_MODEL_ID=models/gemma-4-26b-it

# Supabase Configuration
# Get credentials from your Supabase project settings -> API
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_public_key_here
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_secret_key_here

# Storage Bucket
SUPABASE_STORAGE_BUCKET=complaint-evidence

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
